{
  "name": "valorant-tracker",
  "version": "1.4.12",
  "description": "石橋ぶりぶりトラッカー",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "assets:prepare": "node scripts/build-asset-manifest.js"
  },
  "build": {
    "appId": "com.ishibashi.valoranttracker",
    "productName": "石橋ぶりぶりトラッカー",
    "publish": [
      {
        "provider": "github",
        "owner": "kou6630",
        "repo": "ishibashi-tracker"
      }
    ],
    "files": [
      "main.js",
      "index.html",
      "preload.js",
      "tracker-core.js",
      "tracker-api.js",
      "firebase.js",
      "effect.js",
      "collection-comments.js",
      "tracker-stats.js",
      "tracker-data.js",
      "collection-game.js",
      "collection-operations.js",
      "kayo-farm-data.js",
      "kayo-farm.js",
      "brim-gacha.js",
      "google-account.js",
      "shop.js",
      "login-bonus.js",
      "inbox-utils.js",
      "tracker-style.css",
      "onboarding-style.css",
      "onboarding-logic.js",
      "onboarding-scene.js",
      "startup-camera.js",
      "asset-manager.js",
      "asset-url.js",
      "onboarding.js",
      "img/bootstrap/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "valorant-tracker-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "石橋ぶりぶりトラッカー"
    }
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "three": "^0.180.0"
  }
}
